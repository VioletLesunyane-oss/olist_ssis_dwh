        <mxCell id="btoLRnr5uBYL_UpuvHEh-105" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- Cast types,trim,fix casting&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- Dedupe reviews &amp;amp; geolocation&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- Standardise values &amp;amp; categories&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- Add missing translation&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- Bad roes &amp;gt; etl.error_rows&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- Rebuild from Bronze (re-runnable)&lt;/font&gt;&lt;/div&gt;" vertex="1">
