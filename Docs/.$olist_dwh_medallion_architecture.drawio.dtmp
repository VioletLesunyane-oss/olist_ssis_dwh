        <mxCell id="btoLRnr5uBYL_UpuvHEh-104" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- Load CSV&#39;s in their raw format&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- All columns NVARCHAR, UTF-8&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- Truncate &amp;amp; reload every run&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- Add Metadata&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(55, 66, 96)); font-size: 9px;&quot;&gt;&amp;nbsp;- Create 9 tables&lt;/font&gt;&lt;/div&gt;" vertex="1">
